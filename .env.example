# Copy to .env and load into the environment of the process that runs manage.py / the WSGI server.
# (The app reads os.environ directly; use your service manager, `dotenv`, or PowerShell `$env:` assignments.)

# --- Required in production ---------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=shop.example.com,www.shop.example.com
# Origins allowed to POST (scheme + host), needed when serving over HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com

# --- Reverse proxy / TLS --------------------------------------------------------
# Set to 1 when nginx/Caddy/IIS terminates TLS and forwards X-Forwarded-Proto / X-Forwarded-For.
DJANGO_BEHIND_PROXY=1
# Leave at 1. DJANGO_HTTPS=0 disables Secure cookies/HSTS/redirects for a LAN-only counter with no TLS.
DJANGO_HTTPS=1
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0

# --- Database -------------------------------------------------------------------
# SQLite (default). Point at a path on local disk that is included in backups.
DJANGO_DB_PATH=E:\altab\data\db.sqlite3
# PostgreSQL instead:
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=altab
# DJANGO_DB_USER=altab
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432
# DJANGO_DB_SSLMODE=require
# DJANGO_DB_CONN_MAX_AGE=60

# --- Files ----------------------------------------------------------------------
DJANGO_STATIC_ROOT=E:\altab\staticfiles
DJANGO_MEDIA_ROOT=E:\altab\media

# --- Sessions, rate limits, cache -----------------------------------------------
DJANGO_SESSION_HOURS=12
STORE_LOGIN_ATTEMPTS=8
STORE_CHECKOUTS_PER_10_MIN=10
# Shared cache for rate limits when running more than one worker process (optional; needs `pip install redis`).
# DJANGO_CACHE_URL=redis://127.0.0.1:6379/1

# --- Logging & server -----------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
ALTAB_LISTEN=127.0.0.1:8000
ALTAB_THREADS=8
